@echo off
chcp 65001 > nul
title A股监控系统 - 运行状态检测

echo ====================================================================
echo                A 股监控软件 - 后台运行状态快速检测
echo ====================================================================
echo.

set running=0

for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":8099 " ^| findstr "LISTENING"') do (
    set running=1
    set pid=%%a
)

if %running%==1 (
    echo 【状态】：🟢 正在正常运行中！
    echo 【端口】：8099
    echo 【进程 PID】：%pid%
    echo 【访问看板】：http://127.0.0.1:8099
    echo.
    echo --------------------------------------------------------------------
    echo 提示：数据采集引擎正在后台正常工作。
) else (
    echo 【状态】：🔴 服务未运行（未检测到 8099 监听）。
    echo --------------------------------------------------------------------
    echo 如需启动，请双击运行 run.bat 或 start_silent.vbs
)

echo.
echo ====================================================================
pause
